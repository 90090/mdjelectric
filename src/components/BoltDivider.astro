---
// src/components/BoltDivider.astro
interface Props {
  bg?: string;
}
const { bg = '#111111' } = Astro.props;
---

<div class="bolt-divider" style={`background:${bg}; padding-top:14px;`}>
  <svg viewBox="0 0 1280 28" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <polygon
      points="0,14 80,4 160,18 260,3 340,19 440,2 520,18 620,3 700,19 800,2 880,18 980,3 1060,19 1160,4 1280,14 1280,14 1160,11 1060,24 980,10 880,23 800,9 700,24 620,10 520,23 440,9 340,24 260,10 160,23 80,11 0,14"
      class="bolt-fill"
    />
  </svg>
</div>
