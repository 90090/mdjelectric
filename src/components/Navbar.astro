---
// src/components/Navbar.astro
---

<nav id="navbar">
  <div class="nav-inner">
    <a href="#home" class="nav-logo">
      <img src="/images/logoMDJnobackground.png" alt="MDJ Electric, LLC" />
    </a>

    <div id="nav-links" class="nav-links">
      <a href="#home"     class="nav-link active">Home</a>
      <a href="#services" class="nav-link">Services</a>
      <a href="#about"    class="nav-link">About Us</a>
      <a href="#gallery"  class="nav-link">Our Work</a>
      <a href="#faq"      class="nav-link">Reviews &amp; FAQ</a>
      <a href="#contact"  class="nav-link">Contact</a>
    </div>

    <div class="nav-actions">
      <a href="tel:2037233902" class="btn-gold nav-cta">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.04 1.21 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
        </svg>
        <span class="nav-cta-text">Free Estimate</span>
      </a>
      <button id="hamburger" class="hamburger" aria-label="Open menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu">
    <a href="#home"     class="nav-link">Home</a>
    <a href="#services" class="nav-link">Services</a>
    <a href="#about"    class="nav-link">About Us</a>
    <a href="#gallery"  class="nav-link">Our Work</a>
    <a href="#faq"      class="nav-link">Reviews &amp; FAQ</a>
    <a href="#contact"  class="nav-link">Contact</a>
  </div>
</nav>

<style>
  .nav-inner {
    max-width: 1280px; margin: 0 auto; padding: 0 24px;
    display: flex; align-items: center; justify-content: space-between; height: 70px;
  }
  .nav-logo { display: flex; align-items: center; text-decoration: none; flex-shrink: 0; }
  .nav-logo img { height: 48px; width: auto; object-fit: contain; }
  .nav-links { display: flex; align-items: center; gap: 28px; }
  .nav-actions { display: flex; align-items: center; gap: 12px; }
  .hamburger { display: none; background: none; border: none; cursor: pointer; padding: 6px; }
  .nav-cta { font-size: 0.8rem; padding: 10px 18px; }

  @media (max-width: 1024px) {
    .nav-links { gap: 18px; }
    .nav-link { font-size: 0.85rem; }
  }
  @media (max-width: 900px) {
    .nav-links { display: none; }
    .hamburger { display: block; }
  }
  @media (max-width: 480px) {
    .nav-inner { padding: 0 16px; }
    .nav-logo img { height: 38px; }
    .nav-cta { font-size: 0.72rem; padding: 8px 12px; gap: 5px; }
  }
</style>
