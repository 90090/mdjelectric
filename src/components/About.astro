---
// src/components/About.astro
---

<section id="about" class="about-section">

  <!-- Why Choose band -->
  <div class="why-band">
    <div class="about-inner">
      <div class="reveal" style="text-align:center; margin-bottom:50px;">
        <div class="section-eyebrow">Why MDJ Electric?</div>
        <h2 class="section-title" style="font-size:clamp(1.8rem, 3.5vw, 2.8rem); color:#fff;">
          WHY CHOOSE <span class="gold-text">MDJ ELECTRIC?</span>
        </h2>
      </div>
      <div class="reasons-grid reveal">
        <div class="reason-card">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#f1c600" stroke-width="1.5" class="reason-icon">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/>
          </svg>
          <div class="reason-title">Licensed &amp; Insured</div>
          <div class="reason-desc">Full protection for every project.</div>
        </div>
        <div class="reason-card">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#f1c600" stroke-width="1.5" class="reason-icon">
            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
          </svg>
          <div class="reason-title">Family-Owned</div>
          <div class="reason-desc">We treat your home like our own.</div>
        </div>
        <div class="reason-card">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#f1c600" stroke-width="1.5" class="reason-icon">
            <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
          </svg>
          <div class="reason-title">Honest Communication</div>
          <div class="reason-desc">Clear pricing, no surprises.</div>
        </div>
        <div class="reason-card">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#f1c600" stroke-width="1.5" class="reason-icon">
            <polyline points="9 11 12 14 22 4"/>
            <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
          </svg>
          <div class="reason-title">Clean Workmanship</div>
          <div class="reason-desc">Professional results, every time.</div>
        </div>
        <div class="reason-card">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#f1c600" stroke-width="1.5" class="reason-icon">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          <div class="reason-title">Reliable Scheduling</div>
          <div class="reason-desc">We show up when we say we will.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Our Story -->
  <div class="about-inner">
    <div class="story-grid">

      <div class="reveal about-van">
        <div style="text-align:center;">
          <div class="van-logo-text">
            MD<span>J</span>
            <svg style="display:inline; margin-left:-6px; vertical-align:top; margin-top:6px;" width="32" height="32" viewBox="0 0 12 20" fill="#f1c600">
              <path d="M8 0 L2 10 H7 L1 20 L12 7 H7 Z"/>
            </svg>
          </div>
          <div class="van-company">ELECTRIC, LLC</div>
          <div class="van-divider"></div>
          <div class="van-sub">RESIDENTIAL · COMMERCIAL</div>
          <div class="van-badges">
            <span class="van-badge">🔒 Licensed</span>
            <span class="van-badge">🛡 Insured</span>
            <span class="van-badge">⭐ 5-Star</span>
          </div>
          <div class="van-contact">203.723.3902 · Prospect, CT</div>
        </div>
      </div>

      <div class="reveal">
        <div class="section-eyebrow">Our Story</div>
        <h2 class="section-title" style="font-size:clamp(1.8rem, 3.5vw, 2.8rem); color:#fff; margin-bottom:24px;">
          THE MEANING BEHIND<br /><span class="gold-text">MDJ ELECTRIC</span>
        </h2>
        <div class="gold-bar" style="margin-bottom:28px;"></div>
        <p style="color:#aaa; font-size:0.975rem; line-height:1.8; margin-bottom:18px;">
          "MDJ" comes from the middle names of our four children. While they're still young and not part of the work itself,
          they are the inspiration behind why this company was built — with love, purpose, and the dream of creating
          something meaningful for our family's future.
        </p>
        <p style="color:#aaa; font-size:0.975rem; line-height:1.8; margin-bottom:32px;">
          When you choose MDJ Electric, you're supporting more than a licensed electrical contractor. You're supporting
          a family-owned business built on honesty, hard work, professionalism, and strong community values.
          Every job we complete is done with the same care we'd give our own home.
        </p>
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-num">100%</div>
            <div class="stat-label">Satisfaction Goal</div>
          </div>
          <div class="stat-card">
            <div class="stat-num">5★</div>
            <div class="stat-label">Google Rating</div>
          </div>
        </div>
        <a href="#contact" class="btn-gold" style="margin-top:32px;">
          <svg width="14" height="14" viewBox="0 0 12 20" fill="currentColor"><path d="M8 0 L2 10 H7 L1 20 L12 7 H7 Z"/></svg>
          Work With Us
        </a>
      </div>

    </div>
  </div>

  <!-- Reviews -->
  <div class="about-inner" style="margin-top:80px;">
    <div class="reveal" style="text-align:center; margin-bottom:40px;">
      <div class="section-eyebrow">Testimonials</div>
      <h2 class="section-title" style="font-size:clamp(1.8rem, 3.5vw, 2.8rem); color:#fff;">
        WHAT OUR <span class="gold-text">CLIENTS SAY</span>
      </h2>
    </div>
    <div class="reviews-grid reveal">
      <div class="review-card">
        <div class="stars">★★★★★</div>
        <p class="review-text">"Brian and his team were professional, dependable, and did incredible work in our home. Highly recommend MDJ Electric!"</p>
        <div class="review-attr">– Sarah M., Prospect, CT</div>
      </div>
      <div class="review-card">
        <div class="stars">★★★★★</div>
        <p class="review-text">"Excellent communication, clean work, and very reasonably priced. We will definitely use MDJ Electric again!"</p>
        <div class="review-attr">– James T., Cheshire, CT</div>
      </div>
      <div class="review-card">
        <div class="stars">★★★★★</div>
        <p class="review-text">"From our generator installation to new panel upgrades, everything was flawless. A truly trustworthy company!"</p>
        <div class="review-attr">– Melissa R., Wolcott, CT</div>
      </div>
    </div>
  </div>

</section>

<style>
  .about-section { padding: 100px 0; background: #111; }
  .about-inner   { max-width: 1280px; margin: 0 auto; padding: 0 24px; }

  .why-band {
    background: linear-gradient(135deg,#0d0d0d,#111);
    border-top: 1px solid rgba(241,198,0,0.1);
    border-bottom: 1px solid rgba(241,198,0,0.1);
    padding: 60px 0;
    margin-bottom: 80px;
  }

  /* 5 reason cards */
  .reasons-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
  }
  .reason-icon { margin: 0 auto 16px; display: block; }
  .reason-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800; font-size: 0.95rem;
    color: #fff; letter-spacing: 0.06em;
    text-transform: uppercase; margin-bottom: 6px;
  }
  .reason-desc { font-size: 0.82rem; color: #777; }

  /* Story 2-col */
  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  /* Van card */
  .van-logo-text {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900; font-size: 4.5rem;
    color: #f1c600; line-height: 1;
    letter-spacing: -0.04em;
  }
  .van-company {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800; font-size: 1.2rem;
    color: #f1c600; letter-spacing: 0.2em; margin-bottom: 6px;
  }
  .van-divider { width: 60px; height: 2px; background: #f1c600; margin: 0 auto 12px; }
  .van-sub {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 500; font-size: 0.8rem;
    color: #f1c600; letter-spacing: 0.2em; margin-bottom: 20px;
  }
  .van-badges { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
  .van-contact {
    margin-top: 24px; padding-top: 20px;
    border-top: 1px solid rgba(241,198,0,0.25);
    color: #f1c600; font-size: 0.85rem;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 600; letter-spacing: 0.08em;
  }

  /* Stats */
  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .stat-card {
    text-align: center; padding: 20px;
    background: rgba(241,198,0,0.06);
    border: 1px solid rgba(241,198,0,0.15);
    border-radius: 8px;
  }
  .stat-num {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900; font-size: 2.5rem; color: #f1c600;
  }
  .stat-label { font-size: 0.82rem; color: #888; margin-top: 4px; }

  /* Reviews */
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .stars { color: #f1c600; font-size: 1.1rem; margin-bottom: 14px; }
  .review-text {
    color: #ccc; font-size: 0.9rem; line-height: 1.7;
    font-style: italic; margin-bottom: 16px;
  }
  .review-attr {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700; font-size: 0.85rem;
    color: #f1c600; letter-spacing: 0.06em;
  }

  /* ── Tablet ── */
  @media (max-width: 900px) {
    .reasons-grid { grid-template-columns: repeat(3, 1fr); }
    .story-grid   { grid-template-columns: 1fr; gap: 40px; }
    .reviews-grid { grid-template-columns: 1fr 1fr; }
    .about-section { padding: 70px 0; }
    .why-band { margin-bottom: 60px; }
  }

  /* ── Phone ── */
  @media (max-width: 540px) {
    .about-section { padding: 60px 0; }
    .about-inner   { padding: 0 16px; }
    .why-band      { padding: 40px 0; margin-bottom: 48px; }
    .reasons-grid  { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .reason-card   { padding: 20px 14px; }
    .van-logo-text { font-size: 3.5rem; }
    .reviews-grid  { grid-template-columns: 1fr; }
    .stats-grid    { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 380px) {
    .reasons-grid { grid-template-columns: 1fr; }
  }
</style>
