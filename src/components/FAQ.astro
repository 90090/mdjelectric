---
// src/components/FAQ.astro

const faqs = [
  {
    q: 'Are you licensed and insured in Connecticut?',
    a: 'Yes. MDJ Electric, LLC is fully licensed and insured to perform residential and commercial electrical work throughout Connecticut. We complete all work in accordance with applicable state and local electrical codes. Proof of licensing and insurance is available upon request.',
  },
  {
    q: 'Do you provide free estimates?',
    a: 'Yes. We provide free estimates for planned electrical projects. Requests involving electrical repairs or troubleshooting may require a service visit, which may include a diagnostic fee. We\'ll explain any applicable charges before scheduling your appointment.',
  },
  {
    q: 'What Connecticut areas do you serve?',
    a: 'MDJ Electric is based in Prospect, Connecticut and provides residential and commercial electrical services throughout Central Connecticut and surrounding areas. We proudly serve customers throughout New Haven County, Hartford County, Litchfield County, Middlesex County, and surrounding communities across Connecticut. Our service area extends throughout communities such as Prospect, Bristol, New Britain, Hamden, Middletown, Milford, Fairfield, Southbury, Torrington, and many nearby towns.',
  },
  {
    q: 'Do you install manual and automatic generators?',
    a: 'Yes. MDJ Electric, LLC installs whole-home and automatic standby generators for residential and commercial customers. We handle electrical installation, transfer switch connections, and testing to ensure your generator system is installed safely and properly.',
  },
  {
    q: 'Can you install EV charging stations?',
    a: 'Yes. MDJ Electric, LLC installs residential and commercial EV charging stations for Tesla and other electric vehicle brands. We evaluate your electrical system, determine the best installation approach, and complete the necessary wiring and equipment installation safely and according to electrical code.',
  },
  {
    q: 'Do you offer after-hours emergency electrical service?',
    a: 'Yes. MDJ Electric, LLC provides after-hours emergency service when available. Emergency calls are handled on a first-come, first-served basis, and an emergency service fee applies.',
  },
  {
    q: 'Why does my circuit breaker keep tripping?',
    a: 'A breaker may trip because a circuit is overloaded, too many devices are running at the same time, an appliance has a problem, or there is an issue with the electrical system. Breakers can also trip after power surges or severe weather. If the problem keeps happening, the cause should be identified to ensure your electrical system is operating safely.',
  },
  {
    q: 'Why are my lights flickering?',
    a: 'Flickering lights can be caused by several issues, including loose connections, overloaded circuits, faulty fixtures, or problems within the electrical system. If you notice ongoing flickering or it is happening throughout your home, it may be a sign that the issue should be evaluated.',
  },
  {
    q: 'Why does my home smell like something is burning or have a fishy electrical smell?',
    a: 'An unusual burning, plastic, or fishy smell can be a warning sign of an electrical issue, such as overheating wiring, damaged components, or a failing device. If you notice an unusual electrical odor, turn off the affected equipment if it is safe to do so and have the issue evaluated.',
  },
  {
    q: 'Why is my ceiling fan not working?',
    a: 'A ceiling fan that stops working may have an issue with the motor, switch, wiring, capacitor, or another component. MDJ Electric, LLC can diagnose the cause and determine whether the fan can be repaired or needs replacement.',
  },
];
---

<section id="faq" class="faq-section">
  <div class="faq-inner">

    <!-- Reviews subsection -->
    <div class="reveal reviews-block">
      <div class="section-eyebrow">What Our Customers Say</div>
      <h2 class="section-title faq-h2">CLIENT <span class="gold-text">REVIEWS</span></h2>
      <div class="gold-line"></div>

      <div class="reviews-grid">
        <div class="review-card">
          <div class="stars">★★★★★</div>
          <p class="review-text">"Brian and his team were professional, dependable, and did incredible work in our home. Highly recommend MDJ Electric!"</p>
          <div class="review-attr">– Sarah M., Prospect, CT</div>
        </div>
        <div class="review-card">
          <div class="stars">★★★★★</div>
          <p class="review-text">"Excellent communication, clean work, and very reasonably priced. We will definitely use MDJ Electric again!"</p>
          <div class="review-attr">– James T., Cheshire, CT</div>
        </div>
        <div class="review-card">
          <div class="stars">★★★★★</div>
          <p class="review-text">"From our generator installation to new panel upgrades, everything was flawless. A truly trustworthy company!"</p>
          <div class="review-attr">– Melissa R., Wolcott, CT</div>
        </div>
      </div>

      <!-- Review buttons -->
      <div class="review-buttons">
        <a href="https://share.google/OwAhlbOYO5h1f0pxh" target="_blank" rel="noopener" class="btn-review btn-google">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Read Google Reviews
        </a>
        <a href="https://g.page/r/CQDWONgkBmqbEAE/review" target="_blank" rel="noopener" class="btn-review btn-google-leave">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
          Leave Us a Google Review
        </a>
        <a href="https://www.facebook.com/MDJELECTRICLLC/reviews/?id=61573447733445&sk=reviews" target="_blank" rel="noopener" class="btn-review btn-facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
          </svg>
          Facebook Reviews
        </a>
      </div>
    </div>

    <!-- FAQ -->
    <div class="reveal">
      <div class="section-eyebrow" style="text-align:center; margin-bottom:12px;">Got Questions?</div>
      <h2 class="section-title faq-h2" style="text-align:center;">FREQUENTLY ASKED <span class="gold-text">QUESTIONS</span></h2>
      <div class="gold-line" style="margin-bottom:48px;"></div>

      <div id="faq-list">
        {faqs.map((item) => (
          <div class="faq-item">
            <button class="faq-btn" data-faq-btn>
              {item.q}
              <span class="faq-icon">+</span>
            </button>
            <div class="faq-body">
              <p>{item.a}</p>
            </div>
          </div>
        ))}
      </div>

      <div style="text-align:center; margin-top:48px;">
        <p style="color:#888; margin-bottom:20px;">Still have questions? We're happy to help.</p>
        <a href="#contact" class="btn-gold">Contact Us</a>
      </div>
    </div>

  </div>
</section>

<style>
  .faq-section { padding: 100px 0; background: #0d0d0d; }
  .faq-inner   { max-width: 900px; margin: 0 auto; padding: 0 24px; }
  .gold-line   { width: 60px; height: 3px; background: linear-gradient(90deg,#f1c600,#f5d633); margin: 20px auto 40px; border-radius: 2px; }
  .faq-h2      { font-size: clamp(1.8rem, 3.5vw, 2.8rem); color: #fff; }

  /* Reviews */
  .reviews-block { margin-bottom: 72px; text-align: center; }
  .reviews-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 20px; margin-bottom: 36px;
  }
  .stars { color: #f1c600; font-size: 1.1rem; margin-bottom: 14px; }
  .review-text { color: #ccc; font-size: 0.9rem; line-height: 1.7; font-style: italic; margin-bottom: 14px; }
  .review-attr { font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 0.85rem; color: #f1c600; letter-spacing: 0.06em; }

  /* Review link buttons */
  .review-buttons { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .btn-review {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: 'Barlow Condensed', sans-serif; font-weight: 700;
    font-size: 0.88rem; letter-spacing: 0.06em; text-transform: uppercase;
    text-decoration: none; padding: 12px 20px; border-radius: 4px;
    transition: transform .2s, box-shadow .2s, filter .2s;
    white-space: nowrap;
  }
  .btn-review:hover { transform: translateY(-2px); filter: brightness(1.1); }

  .btn-google {
    background: #fff; color: #333;
    box-shadow: 0 2px 12px rgba(255,255,255,0.15);
  }
  .btn-google-leave {
    background: linear-gradient(135deg,#f1c600,#c9a800); color: #111;
    box-shadow: 0 4px 16px rgba(241,198,0,0.35);
  }
  .btn-facebook {
    background: #1877f2; color: #fff;
    box-shadow: 0 2px 12px rgba(24,119,242,0.35);
  }

  @media (max-width: 768px) {
    .reviews-grid { grid-template-columns: 1fr; gap: 16px; }
    .review-buttons { flex-direction: column; align-items: center; }
    .btn-review { width: 100%; max-width: 320px; justify-content: center; }
  }
  @media (max-width: 540px) {
    .faq-section { padding: 60px 0; }
    .faq-inner   { padding: 0 16px; }
    .faq-btn     { font-size: 0.95rem; padding: 18px 0; }
    .faq-body p  { font-size: 0.88rem; }
  }
</style>
