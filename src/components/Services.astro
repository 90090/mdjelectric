---
// src/components/Services.astro
---

<section id="services" class="services-section">
  <div class="section-inner">

    <!-- Intro header above boxes -->
    <div class="reveal services-intro">
      <h2 class="section-title services-h2">WORKING WITH HOMEOWNERS &amp; INDUSTRY PROFESSIONALS</h2>
      <p class="services-intro-text">
        MDJ Electric provides electrical services for homeowners, general contractors, builders, real estate
        professionals, property managers, and businesses throughout Connecticut.
      </p>
      <p class="services-intro-text">
        With decades of experience in the electrical trade, we understand the importance of communication,
        scheduling, and quality workmanship for residential, commercial, renovation, and improvement projects.
      </p>
      <div class="gold-line"></div>
    </div>

    <!-- Service cards: 4 across, 2 rows -->
    <div class="reveal svc-grid">

      <div class="service-card">
        <div class="service-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f1c600" stroke-width="1.8">
            <rect x="2" y="7" width="20" height="15" rx="2"/>
            <path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/>
            <line x1="12" y1="12" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/>
          </svg>
        </div>
        <h3 class="svc-title">Generators</h3>
        <p class="svc-desc">Manual and automatic standby generator installation, transfer switches, and electrical connections to stay powered during outages.</p>
      </div>

      <div class="service-card">
        <div class="service-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f1c600" stroke-width="1.8">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/>
            <line x1="3" y1="9" x2="9" y2="9"/><line x1="3" y1="15" x2="9" y2="15"/>
          </svg>
        </div>
        <h3 class="svc-title">Service Entrance &amp; Panel Upgrades</h3>
        <p class="svc-desc">Electrical panel replacements and service upgrades to increase capacity, improve safety, and meet today's electrical demands.</p>
      </div>

      <div class="service-card">
        <div class="service-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f1c600" stroke-width="1.8">
            <path d="M5 12H3l9-9 9 9h-2"/>
            <path d="M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
            <path d="M12 12v7"/><circle cx="18" cy="8" r="3"/><path d="M18 5V2"/>
          </svg>
        </div>
        <h3 class="svc-title">EV Chargers</h3>
        <p class="svc-desc">Home and commercial electric vehicle (EV) charging station installations for Tesla and other electric vehicle brands.</p>
      </div>

      <div class="service-card">
        <div class="service-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f1c600" stroke-width="1.8">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          </svg>
        </div>
        <h3 class="svc-title">Lighting &amp; Lighting Controls</h3>
        <p class="svc-desc">Installation, upgrades, service, and repair of interior, exterior, recessed, landscape, security, and custom lighting for residential and commercial properties. Experience working with lighting control systems, including Lutron, nLight, and other leading platforms.</p>
      </div>

      <div class="service-card">
        <div class="service-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f1c600" stroke-width="1.8">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
            <path d="M9 22V12h6v10"/>
          </svg>
        </div>
        <h3 class="svc-title">Full-Service Electrical for Homes &amp; Businesses</h3>
        <p class="svc-desc">Complete electrical services for homeowners, property managers, retail spaces, offices, restaurants, warehouses, and commercial facilities.</p>
      </div>

      <div class="service-card svc-more">
        <svg width="26" height="26" viewBox="0 0 12 20" fill="rgba(241,198,0,0.5)" style="margin-bottom:12px;">
          <path d="M8 0 L2 10 H7 L1 20 L12 7 H7 Z"/>
        </svg>
        <h3 class="svc-title">Additional Electrical Services</h3>
        <ul class="svc-list">
          <li>Ceiling fan installation &amp; replacement</li>
          <li>Smart home device installation</li>
          <li>Hot tub, spa wiring &amp; pool wiring</li>
          <li>Electrical circuit installations for HVAC and water heaters</li>
          <li>Parking lot lighting</li>
        </ul>
        <a href="#contact" class="btn-gold svc-cta-btn">Get a Quote</a>
      </div>

    </div>

    <!-- Why Choose band -->
    <div class="reveal why-band">
      <h3 class="why-title">WHY CHOOSE <span class="gold-text">MDJ ELECTRIC?</span></h3>
      <div class="why-grid">

        <div class="reason-card">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#f1c600" stroke-width="1.5" class="reason-icon">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/>
          </svg>
          <div class="reason-title">Licensed &amp; Insured</div>
          <div class="reason-desc">Licensed electrical contractor providing professional electrical services throughout Connecticut.</div>
        </div>

        <div class="reason-card">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#f1c600" stroke-width="1.5" class="reason-icon">
            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
          </svg>
          <div class="reason-title">Family-Owned</div>
          <div class="reason-desc">Built by a local family, named after our children, and focused on creating a business our community can trust.</div>
        </div>

        <div class="reason-card">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#f1c600" stroke-width="1.5" class="reason-icon">
            <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
          </svg>
          <div class="reason-title">Honest Communication</div>
          <div class="reason-desc">Clear recommendations, upfront expectations, and straightforward solutions.</div>
        </div>

        <div class="reason-card">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#f1c600" stroke-width="1.5" class="reason-icon">
            <polyline points="9 11 12 14 22 4"/>
            <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
          </svg>
          <div class="reason-title">Quality Workmanship</div>
          <div class="reason-desc">Attention to detail and respect for your home or business on every project.</div>
        </div>

        <div class="reason-card">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#f1c600" stroke-width="1.5" class="reason-icon">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          <div class="reason-title">Reliable Service</div>
          <div class="reason-desc">Dependable scheduling, communication, and a commitment to showing up when we say we will.</div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  .services-section { padding: 80px 0; background: #0f0f0f; }
  .section-inner { max-width: 1280px; margin: 0 auto; padding: 0 24px; }

  .services-intro { text-align: center; margin-bottom: 48px; }
  .services-h2 { font-size: clamp(1.6rem, 3.5vw, 2.4rem); color: #fff; margin-bottom: 20px; }
  .services-intro-text {
    color: #aaa; font-size: 1rem; line-height: 1.8;
    max-width: 800px; margin: 0 auto 14px;
  }
  .gold-line { width: 60px; height: 3px; background: linear-gradient(90deg,#f1c600,#f5d633); margin: 24px auto 0; border-radius: 2px; }

  /* 3 across on desktop (6 cards = 2 rows of 3) */
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 60px;
  }

  .svc-title {
    font-family: 'Barlow Condensed', sans-serif; font-weight: 800;
    font-size: 1rem; letter-spacing: 0.05em; color: #fff;
    margin-bottom: 8px; text-transform: uppercase;
  }
  .svc-desc { color: #888; font-size: 0.85rem; line-height: 1.65; }

  .svc-more {
    display: flex; flex-direction: column; align-items: flex-start;
    border-style: dashed !important;
    border-color: rgba(241,198,0,0.25) !important;
  }
  .svc-list {
    color: #888; font-size: 0.85rem; line-height: 1.9;
    padding-left: 18px; margin-bottom: 16px; flex: 1;
  }
  .svc-list li { margin-bottom: 2px; }
  .svc-cta-btn { font-size: 0.78rem; padding: 9px 18px; margin-top: auto; }

  /* Why band */
  .why-band {
    background: linear-gradient(135deg, #111, #0d0d0d);
    border: 1px solid rgba(241,198,0,0.1);
    border-radius: 12px; padding: 48px 40px;
  }
  .why-title {
    font-family: 'Barlow Condensed', sans-serif; font-weight: 900;
    font-size: clamp(1.6rem, 3vw, 2.2rem); color: #fff;
    text-align: center; text-transform: uppercase; margin-bottom: 36px;
  }
  .why-grid {
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px;
  }
  .reason-icon { margin: 0 auto 14px; display: block; }
  .reason-title {
    font-family: 'Barlow Condensed', sans-serif; font-weight: 800;
    font-size: 0.9rem; color: #fff; letter-spacing: 0.06em;
    text-transform: uppercase; margin-bottom: 8px; text-align: center;
  }
  .reason-desc { font-size: 0.82rem; color: #777; text-align: center; line-height: 1.6; }

  @media (max-width: 1024px) {
    .svc-grid { grid-template-columns: repeat(2, 1fr); }
    .why-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 768px) {
    .why-grid { grid-template-columns: repeat(2, 1fr); }
    .why-band { padding: 36px 24px; }
  }
  @media (max-width: 540px) {
    .services-section { padding: 60px 0; }
    .section-inner { padding: 0 16px; }
    .svc-grid { grid-template-columns: 1fr; gap: 12px; }
    .why-grid { grid-template-columns: 1fr; }
    .why-band { padding: 28px 20px; }
  }
</style>
