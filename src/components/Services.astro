---
// src/components/Services.astro

interface Service {
  title: string;
  desc: string;
  icon: string;
}

const services: Service[] = [
  { title: 'Generators',            desc: 'Standby & whole-home generator installs.',         icon: `<rect x="2" y="7" width="20" height="15" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/>` },
  { title: 'Panel Upgrades',        desc: 'Safer, higher-capacity electrical panels.',        icon: `<rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/><line x1="3" y1="9" x2="9" y2="9"/><line x1="3" y1="15" x2="9" y2="15"/>` },
  { title: 'EV Chargers',           desc: 'Level 2 home charging station installs.',         icon: `<path d="M5 12H3l9-9 9 9h-2"/><path d="M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/><path d="M12 12v7"/><circle cx="18" cy="8" r="3"/><path d="M18 5V2"/>` },
  { title: 'Lighting',              desc: 'Indoor, outdoor & smart lighting.',               icon: `<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>` },
  { title: 'Wiring & Rewiring',     desc: 'New construction & full home rewires.',           icon: `<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>` },
  { title: 'Troubleshooting',       desc: 'Diagnostics & repairs done right.',               icon: `<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/>` },
  { title: 'Residential & Commercial', desc: 'Full-service electrical for homes & businesses.', icon: `<path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><path d="M9 22V12h6v10"/>` },
  { title: 'And More',              desc: 'Ceiling fans, outlets, smart home & more.',       icon: ``, isMore: true },
];
---

<section id="services" class="services-section section-pad">
  <div class="section-inner">

    <div class="reveal section-header">
      <div class="section-eyebrow">Our Services</div>
      <h2 class="section-title" style="font-size:clamp(2rem, 4vw, 3rem); color:#fff;">
        COMPLETE ELECTRICAL <span class="gold-text">SOLUTIONS</span>
      </h2>
      <div class="gold-line"></div>
    </div>

    <div class="reveal svc-grid">
      {services.map((s) => (
        s.isMore ? (
          <div class="service-card svc-more">
            <svg width="26" height="26" viewBox="0 0 12 20" fill="rgba(241,198,0,0.4)" style="margin-bottom:10px;">
              <path d="M8 0 L2 10 H7 L1 20 L12 7 H7 Z"/>
            </svg>
            <h3 class="svc-title">And More</h3>
            <p class="svc-desc" style="margin-bottom:14px;">Ceiling fans, outlets, smart home & more.</p>
            <a href="#contact" class="btn-gold" style="font-size:0.75rem; padding:8px 16px;">Get a Quote</a>
          </div>
        ) : (
          <div class="service-card">
            <div class="service-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f1c600" stroke-width="1.8" set:html={s.icon} />
            </div>
            <h3 class="svc-title">{s.title}</h3>
            <p class="svc-desc">{s.desc}</p>
          </div>
        )
      ))}
    </div>

  </div>
</section>

<style>
  .services-section { padding: 80px 0; background: #0f0f0f; }
  .section-inner     { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
  .section-header    { text-align: center; margin-bottom: 40px; }
  .gold-line { width: 60px; height: 3px; background: linear-gradient(90deg,#f1c600,#f5d633); margin: 20px auto 0; border-radius: 2px; }

  /* 4-column grid by default — 2 rows of 4 */
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .svc-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800; font-size: 1rem;
    letter-spacing: 0.05em; color: #fff;
    margin-bottom: 6px; text-transform: uppercase;
  }
  .svc-desc { color: #888; font-size: 0.85rem; line-height: 1.55; }

  .svc-more {
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center;
    border-style: dashed !important;
    border-color: rgba(241,198,0,0.2) !important;
  }

  /* ── Tablet: 2 columns ── */
  @media (max-width: 900px) {
    .svc-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
  }

  /* ── Phone: 2 columns, tighter cards ── */
  @media (max-width: 540px) {
    .services-section { padding: 60px 0; }
    .section-inner    { padding: 0 16px; }
    .svc-grid         { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .service-card     { padding: 16px 14px; }
    .svc-title        { font-size: 0.88rem; }
    .svc-desc         { font-size: 0.78rem; }
    .service-icon     { width: 36px; height: 36px; margin-bottom: 10px; }
  }

  /* ── Very small: 1 column ── */
  @media (max-width: 360px) {
    .svc-grid { grid-template-columns: 1fr; }
  }
</style>
