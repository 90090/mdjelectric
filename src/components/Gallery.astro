---
// src/components/Gallery.astro
const items = [
  { src: '/images/kitchenlighting.JPG',              alt: 'Kitchen lighting installation',   label: 'Kitchen Lighting Installation' },
  { src: '/images/Pilatesstudioprospect.JPG',        alt: 'Full pilates studio wiring',      label: 'Full Pilates Studio Wiring'    },
  { src: '/images/Surgicalvetveterinarianlight.png', alt: 'Surgical veterinary lighting',    label: 'Surgical Veterinary Lighting'  },
  { src: '/images/teslacharger.png',                 alt: 'EV charger installation',         label: 'EV Charger Install'            },
  { src: '/images/Ringfloodlight.png',               alt: 'Full outdoor home rewire',        label: 'Full Outdoor Home Rewire'      },
  { src: '/images/coffeeshop.jpg',                   alt: 'Full coffee shop wiring',         label: 'Full Coffee Shop Wiring'       },
];
---

<section id="gallery" class="gallery-section">
  <div class="gallery-inner">

    <div class="reveal" style="text-align:center; margin-bottom:60px;">
      <div class="section-eyebrow">Our Work</div>
      <h2 class="section-title" style="font-size:clamp(1.8rem, 3.5vw, 2.8rem); color:#fff;">
        QUALITY YOU <span class="gold-text">CAN SEE</span>
      </h2>
      <div class="gold-line"></div>
    </div>

    <div class="gallery-grid reveal">
      {items.map((item) => (
        <div class="gallery-item">
          <img src={item.src} alt={item.alt} loading="lazy" />
          <div class="gallery-overlay"></div>
          <div class="gallery-label">{item.label}</div>
        </div>
      ))}
    </div>

    <div class="reveal" style="text-align:center; margin-top:36px;">
      <a href="#contact" class="btn-gold">
        Start Your Project
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  .gallery-section { padding: 100px 0; background: #111; }
  .gallery-inner   { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
  .gold-line       { width: 60px; height: 3px; background: linear-gradient(90deg,#f1c600,#f5d633); margin: 20px auto 0; border-radius: 2px; }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 220px;
    gap: 8px;
  }

  @media (max-width: 768px) {
    .gallery-section { padding: 70px 0; }
    .gallery-inner   { padding: 0 16px; }
    .gallery-grid    { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 180px; }
  }

  @media (max-width: 480px) {
    .gallery-section { padding: 60px 0; }
    .gallery-grid    { grid-template-columns: 1fr; grid-auto-rows: 200px; gap: 6px; }
  }
</style>
