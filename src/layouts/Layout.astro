---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'MDJ Electric, LLC – Powering Homes & Businesses With Integrity' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="MDJ Electric, LLC – Licensed and insured electrical contractor serving Prospect, CT and all of Connecticut. Generators, panel upgrades, EV chargers, lighting, and more." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="MDJ Electric, LLC – Licensed and insured electrical contractor serving Prospect, CT and all of Connecticut." />
    <meta property="og:image" content="https://mdjelectric.com/og-image1.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MDJ Electric, LLC – Licensed and insured electrical contractor" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://mdjelectric.com/og-image1.png" />
    <meta property="og:url" content="https://mdjelectric.com" />
    <!-- ── Favicon / App Icons ─────────────────────────────
         Place these files in your /public folder:
           /public/favicon.ico          (32×32, legacy browsers)
           /public/favicon.svg          (scalable, modern browsers)
           /public/apple-touch-icon.png (180×180, iOS home screen)
           /public/icon-192.png         (192×192, Android)
           /public/icon-512.png         (512×512, Android splash)
           /public/site.webmanifest     (PWA manifest, see below)
    ────────────────────────────────────────────────────── -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Barlow:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
